{
  "name": "msfjarvis-dev",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "pnpm run generate-redirects && astro build",
    "build:drafts": "WRANGLER_CONFIG_PATH=wrangler.drafts.jsonc INCLUDE_DRAFTS=true pnpm run build",
    "dev": "astro dev",
    "fmt": "oxfmt --write .",
    "format": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "format:check": "oxfmt --check .",
    "generate-redirects": "node scripts/generate-redirects.mjs",
    "import:bookwyrm": "node scripts/import-bookwyrm-reading.mjs",
    "lint": "oxlint .",
    "migrate": "node scripts/migrate-hugo.mjs",
    "mastodon:refresh": "node scripts/refresh-mastodon-snapshots.mjs && oxfmt --write src/data/mastodon-snapshots.ts",
    "new:game": "node scripts/new-entry.mjs games",
    "new:note": "node scripts/new-entry.mjs notes",
    "new:post": "node scripts/new-entry.mjs posts",
    "new:weeknote": "node scripts/new-entry.mjs weeknotes",
    "preview": "astro preview",
    "serve": "astro dev",
    "test": "node --test ./**/*.test.ts scripts/*.test.mjs",
    "types": "wrangler types && oxfmt --write worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "@pagefind/component-ui": "^1.5.2",
    "@sveltia/cms": "^0.246.1",
    "astro": "^7.4.0",
    "astro-expressive-code": "^0.44.2",
    "astro-iconset": "^0.0.6",
    "cheerio": "^1.2.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "pagefind": "^1.5.2",
    "pele": "1.12.0",
    "photoswipe": "^5.4.4",
    "property-information": "^7.2.0",
    "satteri": "^0.10.5",
    "sharp": "^0.35.5",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iconify-json/simple-icons": "^1.2.99",
    "@oxlint/plugins": "1.89.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@xingwangzhe/satteri-photoswipe": "^0.2.6",
    "js-yaml": "^5.4.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "react": "^19.3.0",
    "satori": "^0.47.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "satteri": "^0.9.5",
    "vite": "^7"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "pnpm@12.11.0"
}
