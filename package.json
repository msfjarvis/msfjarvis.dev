    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@xingwangzhe/satteri-photoswipe": "^0.2.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "fs-extra": "^11.4.0",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.2.8",
    "satori": "^0.33.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.131.1"
