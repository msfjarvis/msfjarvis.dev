    "fmt:check": "prettier --check .",
    "format:check": "prettier --check .",
    "generate-redirects": "node scripts/generate-redirects.mjs",
    "import:bookwyrm": "node scripts/import-bookwyrm-reading.mjs",
    "lint": "eslint .",
    "migrate": "node scripts/migrate-hugo.mjs",
    "new:note": "node scripts/new-entry.mjs notes",
    "new:post": "node scripts/new-entry.mjs posts",
    "new:weeknote": "node scripts/new-entry.mjs weeknotes",
    "preview": "astro preview",
    "serve": "astro dev",
    "test": "node --test ./**/*.test.ts scripts/import-bookwyrm-reading.test.mjs",
    "types": "wrangler types && prettier --write worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.4",
    "@mermanjs/web": "^0.7.0",
    "@pagefind/component-ui": "^1.5.2",
    "@sveltia/cms": "^0.207.1",
    "@xingwangzhe/satteri-mermaid": "^0.7.8",
    "astro": "^7.3.2",
    "astro-expressive-code": "^0.44.2",
    "astro-iconset": "^0.0.6",
    "astro-opengraph-images": "^1.20.1",
    "cheerio": "^1.2.0",
    "hast-util-from-html": "^2.0.3",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "property-information": "^7.2.0",
    "satteri": "^0.9.5",
    "sharp": "^0.35.4",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iarna/toml": "^2.2.5",
    "@iconify-json/simple-icons": "^1.2.94",
