---
interface Props {
  src: string;
  label: string;
  type?: string;
  poster?: string;
  scale?: number;
  playbackRate?: number;
  width?: number;
  height?: number;
}

const { src, label, type = /\.webm(?:[?#]|$)/i.test(src) ? "video/webm" : "video/mp4", poster, scale = 1, playbackRate = 1.0, width, height } = Astro.props;
const videoScale = Number.isFinite(scale) && scale > 0 ? scale : 1;
const playbackRateClamped = Number.isFinite(playbackRate) && playbackRate > 0 ? Math.min(playbackRate, 1.0) : 1.0;
---

<figure class="video-player" aria-label={label}>
  <div class="video-media">
    <video controls playsinline muted loop preload="metadata" {poster} {width} {height} aria-label={label} style={`zoom: ${videoScale}`} data-playback-rate={playbackRateClamped}>
      <source {src} {type} />
      Your browser does not support video. <a href={src}>Download the video</a>.
    </video>
    <button class="video-expand" type="button" aria-label={`Expand video: ${label}`} hidden>Expand video</button>
  </div>
  <input class="video-progress" type="range" min="0" max="1000" value="0" aria-label="Video progress" hidden />
</figure>

<noscript>
  <style is:inline>
    .video-player video {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script>
  document.querySelectorAll<HTMLElement>(".video-player").forEach((player) => {
    const video = player.querySelector("video");
    const progress = player.querySelector<HTMLInputElement>(".video-progress");
    const expand = player.querySelector<HTMLButtonElement>(".video-expand");

    if (!video || !progress || !expand) return;

    expand.hidden = false;
    expand.addEventListener("click", () => {
      const dialog = document.createElement("dialog");
      dialog.className = "video-modal";
      dialog.setAttribute("aria-label", video.getAttribute("aria-label") || "Expanded video");

      const close = document.createElement("button");
      close.className = "video-modal__close";
      close.type = "button";
      close.textContent = "Close";
      close.setAttribute("aria-label", "Close expanded video");

      const expanded = video.cloneNode(true) as HTMLVideoElement;
      expanded.removeAttribute("style");
      expanded.controls = true;
      expanded.classList.add("processed");
      expanded.playbackRate = video.playbackRate;
      const wasPlaying = !video.paused;
      const currentTime = video.currentTime;
      video.pause();

      expanded.addEventListener("loadedmetadata", () => {
        expanded.currentTime = currentTime;
      }, { once: true });
      close.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        const resume = !expanded.paused;
        if (expanded.readyState >= 1 && Number.isFinite(expanded.currentTime)) {
          video.currentTime = expanded.currentTime;
        }
        expanded.pause();
        dialog.remove();
        if (resume) void video.play().catch(() => {});
        expand.focus();
      }, { once: true });

      dialog.append(close, expanded);
      document.body.appendChild(dialog);
      dialog.showModal();
      close.focus();
      if (wasPlaying) void expanded.play().catch(() => {});
    });

    video.controls = false;
    video.playbackRate = Number(video.dataset.playbackRate);
    video.tabIndex = 0;
    progress.hidden = false;

    const toggle = () => {
      if (video.paused) void video.play().catch(() => {});
      else video.pause();
    };

    video.addEventListener("click", toggle);
    video.addEventListener("keydown", (event) => {
      if (event.key === " " || event.key === "Enter") {
        event.preventDefault();
        toggle();
      }
    });

    const update = () => {
      const value = Number.isFinite(video.duration) && video.duration > 0 ? video.currentTime / video.duration : 0;
      progress.value = String(Math.round(value * 1000));
      progress.style.setProperty("--progress", `${value * 100}%`);
    };

    video.addEventListener("timeupdate", update);
    video.addEventListener("durationchange", update);
    progress.addEventListener("input", () => {
      if (Number.isFinite(video.duration)) video.currentTime = (Number(progress.value) / 1000) * video.duration;
      update();
    });
    video.classList.add("processed");
    void video.play().catch(() => {});
  });
</script>

<style>
  .video-player {
    margin: 2rem auto;
    width: fit-content;
    max-width: 100%;
  }

  .video-media {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin: auto;
  }

  video {
    display: block;
    max-width: 100%;
    max-height: 75vh;
    width: auto;
    margin: auto;
    background: var(--bg-subtle);
    cursor: pointer;
    opacity: 0;
  }

  video.processed {
    opacity: 1;
  }

  .video-progress:not([hidden]) {
    appearance: none;
    display: block;
    width: 100%;
    height: 24px;
    margin: 0;
    background: linear-gradient(
        to right,
        var(--accent) var(--progress, 0%),
        var(--accent-subtle) var(--progress, 0%)
      ) top / 100% 2px no-repeat;
    cursor: ew-resize;
    opacity: 0;
  }

  .video-player:hover .video-progress,
  .video-player:focus-within .video-progress {
    opacity: 1;
  }

  @media (hover: none) {
    .video-progress:not([hidden]) {
      opacity: 1;
    }
  }

  .video-progress::-webkit-slider-runnable-track {
    height: 2px;
    background: transparent;
  }

  .video-progress::-webkit-slider-thumb {
    appearance: none;
    width: 0;
    height: 0;
  }

  .video-progress::-moz-range-track {
    height: 2px;
    background: transparent;
  }

  .video-progress::-moz-range-thumb {
    border: 0;
    width: 0;
    height: 0;
  }

  .video-expand {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    padding: 0.2rem 0.4rem;
    border: 0;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .video-player:hover .video-expand,
  .video-player:focus-within .video-expand {
    opacity: 1;
  }

  @media (hover: none) {
    .video-expand {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .video-expand {
      transition: none;
    }
  }

  :global(.video-modal) {
    padding: 2.5rem 1rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg);
    color: var(--text);
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 2rem);
  }

  :global(.video-modal::backdrop) {
    background: rgb(0 0 0 / 85%);
  }

  :global(.video-modal video) {
    display: block;
    max-width: min(100%, calc(100vw - 4rem));
    max-height: calc(100dvh - 6rem);
    width: auto;
    height: auto;
  }

  :global(.video-modal__close) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 0.2rem;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    cursor: pointer;
  }

  video:focus-visible,
  input:focus-visible,
  .video-expand:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
