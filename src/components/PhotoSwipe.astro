<script>
  import "photoswipe/style.css";
  import PhotoSwipe from "photoswipe";
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import { defaultSelector } from "@xingwangzhe/satteri-photoswipe";

  type PhotoSwipeUI = NonNullable<PhotoSwipeLightbox["pswp"]>["ui"];

  const registerCaption = (ui: PhotoSwipeUI) => {
    ui?.registerElement({
      name: "caption",
      className: "pswp__caption",
      appendTo: "root",
      onInit: (element, pswp) => {
        pswp.on("change", () => {
          const slideElement = pswp.currSlide?.data.element;
          const caption =
            slideElement instanceof HTMLElement
              ? slideElement.dataset.pswpCaption
              : undefined;
          element.textContent = caption ?? "";
          element.toggleAttribute("hidden", !caption);
        });
      },
    });
  };

  /* Reel variant: mirrors scratch/game-photoblog/viewer.css — a two-line
     caption plus Previous/count/Next pills instead of the default chrome. */
  const registerReelCaption = (ui: PhotoSwipeUI) => {
    ui?.registerElement({
      name: "reel-caption",
      className: "pswp__reel-caption",
      appendTo: "root",
      onInit: (element, pswp) => {
        const title = document.createElement("p");
        title.className = "pswp__reel-title";
        const text = document.createElement("p");
        text.className = "pswp__reel-text";
        element.appendChild(title);
        element.appendChild(text);

        pswp.on("change", () => {
          const slideElement = pswp.currSlide?.data.element;
          const data =
            slideElement instanceof HTMLElement ? slideElement.dataset : null;
          title.textContent = data?.pswpTitle ?? "";
          text.textContent = data?.pswpCaption ?? "";
          title.toggleAttribute("hidden", !title.textContent);
          text.toggleAttribute("hidden", !text.textContent);
        });
      },
    });
  };

  const registerReelControls = (ui: PhotoSwipeUI, total: number) => {
    ui?.registerElement({
      name: "reel-controls",
      className: "pswp__reel-controls",
      appendTo: "root",
      onInit: (element, pswp) => {
        const prev = document.createElement("button");
        prev.type = "button";
        prev.className = "pswp__reel-btn";
        prev.textContent = "Previous";
        prev.setAttribute("aria-label", "Previous frame");
        prev.addEventListener("click", () => pswp.prev());

        const count = document.createElement("span");
        count.className = "pswp__reel-count";
        count.setAttribute("aria-live", "polite");

        const next = document.createElement("button");
        next.type = "button";
        next.className = "pswp__reel-btn";
        next.textContent = "Next";
        next.setAttribute("aria-label", "Next frame");
        next.addEventListener("click", () => pswp.next());

        element.appendChild(prev);
        element.appendChild(count);
        element.appendChild(next);

        pswp.on("change", () => {
          count.textContent = `${pswp.currIndex + 1} / ${total}`;
        });
      },
    });
  };

  const createLightbox = (gallery: HTMLElement, children: string) => {
    const reel = gallery.dataset.pswpVariant === "reel";
    const total =
      reel && typeof children === "string"
        ? gallery.querySelectorAll(children).length
        : 0;

    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children,
      pswpModule: PhotoSwipe,
      ...(reel
        ? {
            bgOpacity: 0.96,
            mainClass: "pswp--reel",
            clickToCloseNonZoomable: false,
            paddingFn: (viewportSize: { x: number }) => {
              const narrow = viewportSize.x < 620;
              return {
                top: narrow ? 36 : 56,
                bottom: narrow ? 150 : 140,
                left: narrow ? 16 : 48,
                right: narrow ? 16 : 48,
              };
            },
          }
        : {}),
    });

    lightbox.on("uiRegister", () => {
      const ui = lightbox.pswp?.ui;
      if (!ui) return;

      if (reel) {
        registerReelCaption(ui);
        registerReelControls(ui, total);
      } else {
        registerCaption(ui);
      }
    });

    lightbox.init();
  };

  const updateColorScheme = (isDark: boolean) => {
    document
      .querySelectorAll<HTMLAnchorElement>("[data-pswp-dark-src]")
      .forEach((item) => {
        const source = isDark
          ? item.dataset.pswpDarkSrc
          : item.dataset.pswpLightSrc;
        if (source) item.href = source;
      });
  };

  const colorScheme = window.matchMedia("(prefers-color-scheme: dark)");
  updateColorScheme(colorScheme.matches);
  colorScheme.addEventListener("change", (event) =>
    updateColorScheme(event.matches),
  );

  document.querySelectorAll("[data-pswp-gallery]").forEach((gallery) => {
    if (gallery instanceof HTMLElement) {
      createLightbox(gallery, defaultSelector);
    }
  });

  const standaloneSelector = `${defaultSelector}:not([data-pswp-gallery] ${defaultSelector})`;
  document.querySelectorAll("[data-pagefind-body]").forEach((article) => {
    if (article instanceof HTMLElement) {
      createLightbox(article, standaloneSelector);
    }
  });
</script>

