<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
  }

  .webring {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .webring a {
    color: var(--text-2);
    border-bottom: none;
  }

  .webring a:hover {
    color: var(--accent);
  }

  .webring a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
