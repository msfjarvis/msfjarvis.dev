---
interface Props {
  src: ImageMetadata | string;
  srcDark?: ImageMetadata | string;
  alt?: string;
  title?: string;
  small: boolean;
}

type ImageMetadata = {
  src: string;
  width: number;
  height: number;
  format: string;
};

const { src, srcDark, alt = "", title, small } = Astro.props;
const image = typeof src === "object" ? src : undefined;
const imageSrc = typeof src === "object" ? src.src : src;
const darkImageSrc =
  typeof srcDark === "object" ? srcDark.src : (srcDark ?? undefined);
const imageLabel = alt || title || "Open image in gallery";
---

<figure data-image-modal-root class={small ? "half" : undefined}>
  <a
    class="pswp-gallery-item image-modal__trigger"
    href={imageSrc}
    data-pswp-light-src={imageSrc}
    data-pswp-dark-src={darkImageSrc}
    data-pswp-width={image?.width}
    data-pswp-height={image?.height}
    data-pswp-caption={title}
    aria-label={imageLabel}
  >
    <span class="image-modal__media">
      <picture>
        {
          srcDark && (
            <source
              media="(prefers-color-scheme: dark)"
              srcset={typeof srcDark === "object" ? srcDark.src : srcDark}
            />
          )
        }
        <img
          src={imageSrc}
          alt={alt}
          loading="lazy"
          decoding="async"
          width={image?.width}
          height={image?.height}
        />
      </picture>
      <span class="image-modal__hint" aria-hidden="true">Expand image</span>
    </span>
  </a>
  {title && <figcaption>{title}</figcaption>}
</figure>

<style>
  [data-image-modal-root] {
    display: block;
  }

  .image-modal__trigger {
    display: block;
    cursor: zoom-in;
  }

  .image-modal__media {
    position: relative;
    display: block;
  }

  .image-modal__media picture,
  .image-modal__media img {
    display: block;
    width: 100%;
  }

  .image-modal__hint {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.2rem 0.4rem;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .image-modal__trigger:hover .image-modal__hint,
  .image-modal__trigger:focus-visible .image-modal__hint {
    opacity: 1;
  }
</style>
