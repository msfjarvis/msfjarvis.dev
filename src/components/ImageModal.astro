---
import { getImage } from "astro:assets";

type ImageMetadata = {
  src: string;
  width: number;
  height: number;
  format:
    "jpeg" | "jpg" | "png" | "apng" | "tiff" | "webp" | "gif" | "svg" | "avif";
};

interface Props {
  src: ImageMetadata | string;
  srcDark?: ImageMetadata | string;
  alt?: string;
  title?: string;
  small: boolean;
}

const { src, srcDark, alt = "", title, small } = Astro.props;
const image = typeof src === "object" ? src : undefined;
const darkImage = typeof srcDark === "object" ? srcDark : undefined;
const imageSrc = typeof src === "object" ? src.src : src;
const darkImageSrc =
  typeof srcDark === "object" ? srcDark.src : (srcDark ?? undefined);
const [imageAvif, imageWebp, darkImageAvif, darkImageWebp] = await Promise.all([
  image && getImage({ src: image, format: "avif" }),
  image && getImage({ src: image, format: "webp" }),
  darkImage && getImage({ src: darkImage, format: "avif" }),
  darkImage && getImage({ src: darkImage, format: "webp" }),
]);
const imageLabel = alt || title || "Open image in gallery";
---

<figure data-image-modal-root class={small ? "half" : undefined}>
  <a
    class="pswp-gallery-item image-modal__trigger"
    href={imageSrc}
    data-pswp-light-src={imageSrc}
    data-pswp-dark-src={darkImageSrc}
    data-pswp-width={image?.width}
    data-pswp-height={image?.height}
    data-pswp-caption={title}
    aria-label={imageLabel}
  >
    <span class="image-modal__media">
      <picture>
        {
          darkImageAvif && (
            <source
              media="(prefers-color-scheme: dark)"
              srcset={darkImageAvif.src}
              type="image/avif"
            />
          )
        }
        {
          darkImageWebp && (
            <source
              media="(prefers-color-scheme: dark)"
              srcset={darkImageWebp.src}
              type="image/webp"
            />
          )
        }
        {
          typeof srcDark === "string" && (
            <source media="(prefers-color-scheme: dark)" srcset={srcDark} />
          )
        }
        {imageAvif && <source srcset={imageAvif.src} type="image/avif" />}
        <img
          src={imageWebp?.src ?? imageSrc}
          alt={alt}
          loading="lazy"
          decoding="async"
          width={image?.width}
          height={image?.height}
        />
      </picture>
      <span class="image-modal__hint" aria-hidden="true">Expand image</span>
    </span>
  </a>
  {title && <figcaption>{title}</figcaption>}
</figure>

<style>
  [data-image-modal-root] {
    display: block;
  }

  .image-modal__trigger {
    display: block;
    cursor: zoom-in;
  }

  .image-modal__media {
    position: relative;
    display: block;
  }

  .image-modal__media picture,
  .image-modal__media img {
    display: block;
    width: 100%;
  }

  .image-modal__hint {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.2rem 0.4rem;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .image-modal__trigger:hover .image-modal__hint,
  .image-modal__trigger:focus-visible .image-modal__hint {
    opacity: 1;
  }
</style>
