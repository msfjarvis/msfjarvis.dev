---
// CMS admin page — not indexed, not part of the public site.
// Sveltia CMS is loaded as a bundled package dependency; all config,
// editor components, and event hooks live in the <script> block below.

export const prerender = true;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager</title>
  </head>
  <body>
    <script>
      import CMS, { type CmsConfig } from "@sveltia/cms";
      import { deriveWeeknoteMetadata } from "../../lib/weeknote-metadata";
      import { openLibraryBookMetadataFields } from "../../lib/cms/open-library-book-fields";
      import {
        applyImportedBook,
        isImportedBook,
      } from "../../lib/cms/open-library-book-import";
      import {
        createOpenLibraryBookField,
        type CmsReactRuntime,
      } from "../../lib/cms/open-library-book-field";

      // ─── Tombstone hook ───────────────────────────────────────────────────────

      function normalizeBlogEntryForSave(entry: {
        collection: string;
        data: Record<string, unknown>;
      }): typeof entry {
        const data = structuredClone(entry.data ?? {});
        if (
          entry.collection !== "pages" &&
          entry.collection !== "books" &&
          !data.deleted
        ) {
          data.deleted = false;
        }
        return { ...entry, data };
      }

      function expandImportedBook(
        data: Record<string, unknown>,
      ): Record<string, unknown> {
        const { bookImport, ...bookData } = data;
        return isImportedBook(bookImport)
          ? applyImportedBook(data, bookImport)
          : bookData;
      }

      function presentTimestamp(value: unknown): string | undefined {
        return typeof value === "string" && value.trim() ? value : undefined;
      }

      function normalizeBookForSave(
        data: Record<string, unknown>,
      ): Record<string, unknown> {
        const normalized = structuredClone(data);
        if (normalized.bookAuthors === undefined) normalized.bookAuthors = [];
        const finishedAt = presentTimestamp(normalized.readingFinishedAt);
        const stoppedAt = presentTimestamp(normalized.readingStoppedAt);
        if (finishedAt && stoppedAt) {
          throw new Error("A book cannot be both finished and stopped.");
        }
        const lastReadAt =
          finishedAt ??
          stoppedAt ??
          presentTimestamp(normalized.readingStartedAt);
        if (lastReadAt) normalized.readingLastReadAt = lastReadAt;
        return normalized;
      }

      CMS.registerEventListener({
        name: "preSave",
        handler: ({ entry }) => {
          const plain = entry.toJS();
          const data =
            plain.collection === "books"
              ? normalizeBookForSave(expandImportedBook(plain.data))
              : plain.data;
          if (
            plain.collection === "books" &&
            !plain.path &&
            (!String(data.bookTitle ?? "").trim() ||
              !String(data.bookWork ?? "").trim())
          ) {
            throw new Error(
              "New books require a title and Open Library work URL.",
            );
          }
          const normalized = normalizeBlogEntryForSave({
            collection: plain.collection,
            data,
          });
          return entry.set(
            "data",
            entry.get("data").clear().merge(normalized.data),
          );
        },
      });

      const cmsReact = window as typeof window & CmsReactRuntime;
      CMS.registerFieldType(
        "open-library-book",
        createOpenLibraryBookField(cmsReact),
      );

      // ─── Figure editor component ──────────────────────────────────────────────

      const FIGURE_MDX_PATTERN = /^<Figure\s+([\s\S]+?)\s*\/>\s*$/;
      const ATTR_PATTERN = /(\w+)="((?:\\.|[^"\\])*)"/g;

      function escapeAttr(value: unknown): string {
        return String(value ?? "")
          .replace(/\\/g, "\\\\")
          .replace(/"/g, '\\"');
      }

      function unescapeAttr(value: unknown): string {
        return String(value ?? "")
          .replace(/\\"/g, '"')
          .replace(/\\\\/g, "\\");
      }

      function parseAttrs(str: string): Record<string, string> {
        const attrs: Record<string, string> = {};
        ATTR_PATTERN.lastIndex = 0;
        let m: RegExpExecArray | null;
        while ((m = ATTR_PATTERN.exec(str)) !== null) {
          attrs[m[1]] = unescapeAttr(m[2]);
        }
        return attrs;
      }

      CMS.registerEditorComponent({
        id: "figure",
        label: "Figure",
        fields: [
          { name: "src", label: "Image", widget: "image" },
          { name: "alt", label: "Alt text", widget: "text", required: false },
          {
            name: "title",
            label: "Title/caption",
            widget: "string",
            required: false,
          },
        ],
        pattern: FIGURE_MDX_PATTERN,
        fromBlock(match: RegExpMatchArray) {
          const attrs = parseAttrs(match[1] ?? "");
          return {
            src: attrs.src,
            alt: attrs.alt ?? "",
            title: attrs.title ?? "",
          };
        },
        toBlock(data: Record<string, string>) {
          const parts = [`src="${escapeAttr(data.src)}"`];
          if (data.alt) parts.push(`alt="${escapeAttr(data.alt)}"`);
          if (data.title) parts.push(`title="${escapeAttr(data.title)}"`);
          return `<Figure ${parts.join(" ")} />`;
        },
        toPreview(data: Record<string, string>) {
          const img = `<img src="${data.src}" alt="${data.alt ?? ""}">`;
          return data.title
            ? `<figure>${img}<figcaption>${data.title}</figcaption></figure>`
            : `<figure>${img}</figure>`;
        },
      });

      // ─── CMS configuration ────────────────────────────────────────────────────

      // Sveltia has no ISO-week template tag. Calculate the configured default at
      // load time instead, matching the CLI's canonical weeknote naming scheme.
      const newWeeknote = deriveWeeknoteMetadata(new Date());

      const config: CmsConfig = {
        load_config_file: false,
        output: {
          omit_empty_optional_fields: true,
          yaml: { quote: "double" },
        },
        backend: {
          name: "github",
          repo: "msfjarvis/msfjarvis.dev",
          base_url: "https://sveltia-cms-auth.tiger-shark.workers.dev/",
          skip_ci: true,
        },
        media_libraries: {
          cloudflare_r2: {
            access_key_id: "a1e50eaa4bbd04c61611f5c20545ea6a",
            bucket: "blog-images",
            account_id: "07d4cd9cc7e8077fcafc5dd2fc30391b",
            public_url: "https://pub-fc205806d138406e8667d8d0c8a32a9f.r2.dev",
          },
          default: {
            config: {
              transformations: {
                raster_image: { format: "webp", quality: 85 },
                svg: { optimize: true },
              },
            },
          },
        },
        collections: [
          {
            name: "posts",
            label: "Posts",
            folder: "src/content/posts",
            format: "yaml-frontmatter",
            extension: "mdx",
            create: true,
            path: "{{slug}}/index",
            slug: "{{slug}}",
            media_folder: "",
            public_folder: "",
            editor: { preview: true },
            fields: [
              { label: "Title", name: "title", widget: "string" },
              {
                label: "Date",
                name: "date",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                default: "{{now}}",
                picker_utc: false,
              },
              {
                label: "Last modified",
                name: "lastmod",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                default: "{{now}}",
                picker_utc: false,
                required: false,
              },
              {
                label: "Summary",
                name: "summary",
                widget: "string",
                required: false,
              },
              { label: "Tags", name: "tags", widget: "list", required: false },
              {
                label: "Draft",
                name: "draft",
                widget: "boolean",
                required: false,
              },
              {
                label: "Deleted",
                name: "deleted",
                widget: "boolean",
                required: false,
              },
              {
                label: "Body",
                name: "body",
                widget: "markdown",
                editor_components: ["code-block", "image", "figure"],
                modes: ["raw", "rich_text"],
              },
            ],
          },
          {
            name: "notes",
            label: "Notes",
            folder: "src/content/notes",
            format: "yaml-frontmatter",
            extension: "mdx",
            create: true,
            path: "{{slug}}/index",
            slug: "{{slug}}",
            media_folder: "",
            public_folder: "",
            editor: { preview: false },
            fields: [
              { label: "Title", name: "title", widget: "string" },
              {
                label: "Date",
                name: "date",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                default: "{{now}}",
                picker_utc: false,
              },
              {
                label: "Last modified",
                name: "lastmod",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                default: "{{now}}",
                picker_utc: false,
                required: false,
              },
              { label: "Tags", name: "tags", widget: "list", required: false },
              {
                label: "Deleted",
                name: "deleted",
                widget: "boolean",
                required: false,
              },
              {
                label: "Body",
                name: "body",
                widget: "markdown",
                modes: ["raw", "rich_text"],
              },
            ],
          },
          {
            name: "books",
            label: "Books",
            folder: "src/content/books",
            format: "yaml-frontmatter",
            extension: "mdx",
            create: true,
            path: "{{slug}}/index",
            // Sveltia normalizes this template into a URL slug. Collision
            // resolution is intentionally left to the CMS save flow; no
            // undocumented slug API is used here.
            slug: "{{bookImport.bookTitle}}",
            media_folder: "",
            public_folder: "",
            summary: "{{bookTitle}} — {{readingShelf}}",
            sortable_fields: {
              fields: ["readingLastReadAt"],
              default: { field: "readingLastReadAt", direction: "descending" },
            },
            editor: { preview: false },
            fields: [
              {
                label: "Import from Open Library",
                name: "bookImport",
                widget: "open-library-book",
                required: false,
              },
              {
                label: "Title",
                name: "bookTitle",
                widget: "string",
                required: false,
              },
              ...openLibraryBookMetadataFields,
              {
                label: "Reading shelf",
                name: "readingShelf",
                widget: "select",
                default: "reading",
                options: ["read", "reading", "stopped-reading"],
              },
              {
                label: "Started reading",
                name: "readingStartedAt",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                picker_utc: true,
                required: false,
              },
              {
                label: "Finished reading",
                name: "readingFinishedAt",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                picker_utc: true,
                required: false,
              },
              {
                label: "Stopped reading",
                name: "readingStoppedAt",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                picker_utc: true,
                required: false,
              },
              {
                label: "Last read",
                name: "readingLastReadAt",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                picker_utc: true,
                required: false,
              },
              {
                label: "Body",
                name: "body",
                widget: "markdown",
                modes: ["raw", "rich_text"],
                required: false,
              },
            ],
          },
          {
            name: "pages",
            label: "Pages",
            folder: "src/pages",
            format: "yaml-frontmatter",
            extension: "mdx",
            create: false,
            fields: [
              {
                name: "layout",
                widget: "hidden",
                default: "../layouts/BaseLayout.astro",
              },
              { label: "Title", name: "title", widget: "string" },
              { label: "Description", name: "description", widget: "string" },
              {
                label: "Body",
                name: "body",
                widget: "markdown",
                modes: ["raw", "rich_text"],
              },
            ],
          },
          {
            name: "weeknotes",
            label: "Weeknotes",
            folder: "src/content/weeknotes",
            format: "yaml-frontmatter",
            extension: "mdx",
            create: true,
            path: "{{slug}}/index",
            slug: newWeeknote.slug,
            media_folder: "",
            public_folder: "",
            editor: { preview: true },
            fields: [
              {
                label: "Title",
                name: "title",
                widget: "string",
                default: newWeeknote.title,
              },
              {
                label: "Date",
                name: "date",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                default: "{{now}}",
                picker_utc: false,
              },
              {
                label: "Last modified",
                name: "lastmod",
                widget: "datetime",
                format: "YYYY-MM-DDTHH:mm:ssZ",
                default: "{{now}}",
                picker_utc: false,
                required: false,
              },
              {
                label: "Summary",
                name: "summary",
                widget: "string",
                required: false,
              },
              { label: "Tags", name: "tags", widget: "list", required: false },
              {
                label: "Draft",
                name: "draft",
                widget: "boolean",
                required: false,
              },
              {
                label: "Deleted",
                name: "deleted",
                widget: "boolean",
                required: false,
              },
              {
                label: "Body",
                name: "body",
                widget: "markdown",
                editor_components: ["code-block", "image", "figure"],
                modes: ["raw", "rich_text"],
              },
            ],
          },
        ],
      };

      await CMS.init({ config });
    </script>
  </body>
</html>
