---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Figure from "../../components/Figure.astro";

export const prerender = true;

const games = await getCollection("games");
games.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<!--TODO(msfjarvis): add feeds -->
<BaseLayout
  title="Game Photography"
  description="In-game photography/videography from the video games I've played"
  alternateFeeds={[]}
>
  <h1>Games</h1>
  {
    // TODO(msfjarvis): The Figure URL doesn't seem to load, and the styling is currently non-existent.
    games.map((game) => (
      <>
        <Figure src={game.data.cover} />
        <h2>{game.data.title}</h2>
      </>
    ))
  }
</BaseLayout>
