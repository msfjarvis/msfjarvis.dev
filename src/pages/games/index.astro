---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

const games = await getCollection("games");
games.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<!--TODO(msfjarvis): add feeds -->
<BaseLayout
  title="Game Photography"
  description="In-game photography/videography from the video games I've played"
  alternateFeeds={[]}
>
  <h1>Games</h1>
  <ul class="game-list">
    {
      games.map((game) => (
        <li>
          <a class="game-link" href={`/games/${game.id}/`}>
            <img
              class="game-cover"
              src={game.data.cover.src}
              alt=""
              width={game.data.cover.width}
              height={game.data.cover.height}
              loading="lazy"
              decoding="async"
            />
            <span class="game-meta">
              <span class="game-title">{game.data.title}</span>
              <span class="game-date">
                <FormattedDate date={game.data.date} />
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  h1 {
    margin-top: 0;
  }
  .game-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .game-link {
    display: grid;
    gap: 0.75rem;
    color: inherit;
    border-bottom: none;
    text-decoration: none;
  }
  .game-cover {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: border-color 150ms ease;
  }
  .game-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .game-title {
    font-family: var(--font-mono);
    font-size: 1rem;
  }
  .game-date {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-2);
  }
  .game-link:hover .game-title,
  .game-link:focus-visible .game-title {
    color: var(--accent);
  }
  .game-link:hover .game-cover {
    border-color: var(--accent-subtle);
  }
  .game-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .game-cover {
      transition: none;
    }
  }
</style>
