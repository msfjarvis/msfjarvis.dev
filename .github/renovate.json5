{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    "github>msfjarvis/shared-workflows//renovate/automerge",
  ],
  packageRules: [
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchDatasources: ["npm"],
      minimumReleaseAge: "7 days",
      groupName: "NPM dependencies",
      groupSlug: "npm-deps",
      commitMessagePrefix: "chore(deps):",
      commitMessageAction: "update",
      commitMessageTopic: "npm dependencies",
      commitBody: "{{#each upgrades}}\n- {{{depName}}}: {{{currentVersion}}} -> {{{newVersion}}}\n{{/each}}",
    },
    {
      matchDatasources: ["npm"],
      matchPackageNames: ["@sveltia/cms"],
      minimumReleaseAge: null,
    },
    {
      matchDatasources: ["npm"],
      matchPackageNames: ["satori", "satteri"],
      enabled: false,
    },
  ],
}
